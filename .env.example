# AgentPay — environment template. Copy to .env and fill in.
# NEVER commit the real .env (deployer keys must stay private).

# Prisma (SQLite) for merchant profiles, sessions, nonces, passkeys
DATABASE_URL="file:./db/custom.db"

# Hardhat deployer key for agentpay/contracts (testnet ONLY — use a burner)
DEPLOYER_PRIVATE_KEY=

# QIE network the dashboard targets (default: qieTestnet)
# NEXT_PUBLIC_QIE_NETWORK=qieTestnet

# Optional RPC override for server-side calls (default: first official RPC)
# QIE_RPC_URL=https://rpc1testnet.qie.digital/

# Testnet funder used by scripts/e2e_*.mjs (testnet keys only — never a mainnet key)
FUNDER_KEY=
