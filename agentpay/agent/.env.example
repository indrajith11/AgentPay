# AgentPay Agent Daemon — env
# Copy to .env and fill in. Addresses: agentpay/contracts/addresses/qieTestnet.json
# (mainnet: qieMainnet.json once the P6 deploy lands, or AGENTPAY_NETWORK=qieMainnet via @agentpay/sdk)

# RPC rotation (comma-separated; daemon fails over automatically)
RPC_URLS=https://rpc1testnet.qie.digital/,https://rpc2testnet.qie.digital/,https://rpc3testnet.qie.digital/

# Agent wallet key (the EOA that runs reconciliation / collections / treasury sweeps)
# NEVER commit a real key. Use a dedicated agent wallet bound via AgentRegistry.bindPrincipal.
AGENT_PRIVATE_KEY=

# Loop cadence
AGENT_INTERVAL_SECONDS=60

# Ledger CSV output directory
LEDGER_DIR=./ledger

# Optional webhook for ledger summaries + reminders (WhatsApp/SMS gateway in prod)
WEBHOOK_URL=

# Treasury keeper arms itself only when this is "false" (default = dry-run logs)
TREASURY_DRY_RUN=true

# --- Contract addresses (testnet 1983) ---
MERCHANT_REGISTRY=0x7918e72d7725E87D3C09bB80873991a05BaEc9aA
AGENT_REGISTRY=0x715f9449145C2FC74c74556154F17C522a30ED09
